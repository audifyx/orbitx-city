# Copy to .env.local for `npm run dev`, and paste the same names into
# Vercel → Project → Settings → Environment Variables.
# Leave a line blank to skip that service. The game still runs.
# Vercel injects these on its own when you connect a Marketplace integration.
# After you add or change one, redeploy so the new build picks it up.

# Supabase (Vercel Marketplace → Supabase). This is the shared world and the login.
# Run supabase/schema.sql once in the Supabase SQL editor (it includes the wallet tables).
# Or run supabase/migrations/20261111140000_auth_and_wallets.sql after an older schema.
# The service role stays on the server. The anon key is public.
# Either name pair works: SUPABASE_* or NEXT_PUBLIC_SUPABASE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Neon Postgres (optional if you are not using Supabase). Either name works.
DATABASE_URL=
POSTGRES_URL=

# Upstash Redis (Vercel Marketplace → Upstash). Either pair works.
# Add this if you want one shared public world across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# LiveKit Cloud (free tier). Voice falls back to browser-to-browser
# WebRTC through the same API when these are empty.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# In-app Solana wallets. The server creates one key per account.
# WALLET_MASTER_KEY is 32 bytes, base64 (openssl rand -base64 32). It never goes in the database.
# Leave it blank and accounts still work; wallets are not created until it is set.
WALLET_MASTER_KEY=

# Default network is devnet. Set mainnet-beta only after a separate review.
# SOLANA_RPC_URL overrides the public default for that network.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=
ORBITX_MINT=
ORBITX_HOLDER_MIN=1

# Shop, apartments, and the arcade stay on demo credits.
# ONCHAIN_SHOP_ENABLED is plumbing only. It does not move real tokens.
ONCHAIN_SHOP_ENABLED=false
# Mainnet sends stay off unless this is the exact string true.
ONCHAIN_TRANSFERS_ENABLED=false
# Daily SOL cap, in lamports. Default 1000000000 (1 SOL) when this is empty.
ONCHAIN_DAILY_LAMPORTS=
