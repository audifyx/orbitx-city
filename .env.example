# Copy to .env.local for `npm run dev`, and paste the same names into
# Vercel → Project → Settings → Environment Variables.
# Leave a line blank to skip that service. The game still runs.
# Vercel injects these on its own when you connect a Marketplace integration.
# After you add or change one, redeploy so the new build picks it up.

# Supabase (Vercel Marketplace → Supabase). This is the shared world.
# Run supabase/schema.sql once in the Supabase SQL editor.
# The service role stays on the server. The anon key is public and is only
# allowed to read presence and chat.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Neon Postgres (optional if you are not using Supabase). Either name works.
DATABASE_URL=
POSTGRES_URL=

# Upstash Redis (Vercel Marketplace → Upstash). Either pair works.
# Add this if you want one shared public world across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# LiveKit Cloud (free tier). Voice falls back to browser-to-browser
# WebRTC through the same API when these are empty.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional read-only Solana check. Leave the mint blank to skip it.
# The game never sends a transaction. See DEPLOY.md.
# SOLANA_RPC_URL defaults to a public mainnet endpoint when the mint is set.
ORBITX_MINT=
SOLANA_RPC_URL=
ORBITX_HOLDER_MIN=1
